// Prisma schema for PrimeCFO.ai aligned to the authentic Supabase production database
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. CLIENT ENTITIES
// ==========================================
model Client {
  id                     String   @id @default(uuid()) @map("client_id") @db.Uuid
  clientName             String   @map("client_name")
  companyName            String?  @map("company_name")
  email                  String   @unique
  phone                  String?
  notes                  String?
  tags                   String[] @default([])
  clientType             String?  @map("client_type")
  isActive               Boolean? @default(true) @map("is_active")
  qboCustomerId          String?  @map("qbo_customer_id")
  userId                 String?  @map("user_id") @db.Uuid
  qboReportBasis         String?  @map("qbo_report_basis")
  reportingBasisOverride String?  @map("reporting_basis_override")
  hasInvoicingActivity   Boolean? @map("has_invoicing_activity")
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  qboConnections         ClientQboConnection[]
  qboTokens              QboToken[]
  financialMetrics       FinancialMetric[]
  financialReports       FinancialReport[]
  financialReportPeriods FinancialReportPeriod[]

  @@map("clients")
}

// ==========================================
// 2. QUICKBOOKS ONLINE OAUTH CONNECTIONS
// ==========================================
model ClientQboConnection {
  id          String    @id @default(uuid()) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  companyId   String    @map("company_id")
  customerId  String?   @map("customer_id")
  realmId     String?   @map("realm_id")
  syncEnabled Boolean?  @default(false) @map("sync_enabled")
  sandboxMode Boolean?  @default(false) @map("sandbox_mode")
  status      String?   @default("pending")
  notes       String?
  connectedAt DateTime? @map("connected_at") @db.Timestamptz
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_qbo_connections")
}

// ==========================================
// 3. QUICKBOOKS TOKEN VAULT
// ==========================================
model QboToken {
  id           String    @id @default(uuid()) @db.Uuid
  clientId     String    @unique @map("client_id") @db.Uuid
  companyId    String    @map("company_id")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("qbo_tokens")
}

// ==========================================
// 4. FINANCIAL REPORT PERIODS
// ==========================================
model FinancialReportPeriod {
  id         String    @id @default(uuid()) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  periodType String    @map("period_type")
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  label      String

  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metrics    FinancialMetric[]
  reports    FinancialReport[]

  @@index([clientId])
  @@map("financial_report_periods")
}

// ==========================================
// 5. FINANCIAL METRICS (KEY-VALUE ACCOUNTING)
// ==========================================
model FinancialMetric {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  periodId  String   @map("period_id") @db.Uuid
  metricKey String   @map("metric_key")
  value     Decimal  @db.Decimal
  unit      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period FinancialReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([periodId])
  @@map("financial_metrics")
}

// ==========================================
// 6. FINANCIAL REPORTS (RAW ACCOUNTING TREES)
// ==========================================
model FinancialReport {
  id         String   @id @default(uuid()) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  reportType String   @map("report_type")
  periodId   String   @map("period_id") @db.Uuid
  source     String
  rawJson    Json     @map("raw_json")
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period FinancialReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([periodId])
  @@map("financial_reports")
}

// ==========================================
// 7. AI INSIGHTS
// ==========================================
model AiInsight {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @map("client_id")
  periodId        String?  @map("period_id") @db.Uuid
  reportRange     String?  @map("report_range")
  title           String
  description     String
  urgency         String
  category        String
  metric          String?
  metricValue     String?  @map("metric_value")
  recommendations Json?
  talkingPoints   Json?    @map("talking_points")
  severityOrder   Int      @map("severity_order")
  snapshotId      String?  @map("snapshot_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([clientId])
  @@map("ai_insights")
}

// ==========================================
// 8. AI RISK POSTURE
// ==========================================
model AiRiskPosture {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @map("client_id")
  reportRange String   @map("report_range")
  rating      String
  summary     String
  topAction   String?  @map("top_action")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([clientId])
  @@map("ai_risk_posture")
}

// ==========================================
// 9. FINANCIAL ALERT EVENTS
// ==========================================
model FinancialAlert {
  id             String    @id @default(uuid()) @db.Uuid
  clientId       String    @map("client_id")
  alertKind      String    @map("alert_kind")
  state          String
  severityKey    String    @map("severity_key")
  title          String
  body           String
  meta           Json
  snoozedUntil   DateTime? @map("snoozed_until") @db.Timestamptz
  lastNotifiedAt DateTime? @map("last_notified_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([clientId])
  @@map("financial_alert_events")
}

// ==========================================
// 10. QUICKBOOKS CONNECTIONS (HISTORICAL/ACTIVE)
// ==========================================
model QuickbooksConnection {
  id               String    @id @default(uuid()) @db.Uuid
  clientId         String    @map("client_id")
  realmId          String    @map("realm_id")
  accessToken      String    @map("access_token")
  refreshToken     String    @map("refresh_token")
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz
  refreshExpiresAt DateTime  @map("refresh_expires_at") @db.Timestamptz
  scope            String?
  status           String
  lastRefreshError String?   @map("last_refresh_error")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([clientId])
  @@map("quickbooks_connections")
}

// ==========================================
// 11. STRIPE CUSTOMERS & SUBSCRIPTIONS
// ==========================================
model StripeCustomer {
  userId           String   @id @map("user_id") @db.Uuid
  stripeCustomerId String   @map("stripe_customer_id")
  email            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("stripe_customers")
}

model StripeSubscription {
  stripeSubscriptionId String    @id @map("stripe_subscription_id")
  userId               String    @map("user_id") @db.Uuid
  stripeCustomerId     String    @map("stripe_customer_id")
  status               String
  planId               String?   @map("plan_id")
  priceId              String?   @map("price_id")
  interval             String?
  currentPeriodStart   DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  trialEnd             DateTime? @map("trial_end") @db.Timestamptz
  cancelAtPeriodEnd    Boolean   @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("stripe_subscriptions")
}

model StripeWebhookEvent {
  id           String    @id
  type         String
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt  DateTime? @map("processed_at") @db.Timestamptz
  errorMessage String?   @map("error_message")

  @@map("stripe_webhook_events")
}

// ==========================================
// 12. EMAIL PREFERENCES
// ==========================================
model EmailPreference {
  userId                String    @id @map("user_id") @db.Uuid
  aiSummaryEnabled      Boolean   @map("ai_summary_enabled")
  marketingEnabled      Boolean   @map("marketing_enabled")
  unsubscribedAt        DateTime? @map("unsubscribed_at") @db.Timestamptz
  welcomeSnapshotSentAt DateTime? @map("welcome_snapshot_sent_at") @db.Timestamptz
  lastSummarySentAt     DateTime? @map("last_summary_sent_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("email_preferences")
}

// ==========================================
// 13. ADVISOR BOOKINGS
// ==========================================
model AdvisorBooking {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  calendlyEventUri   String?   @map("calendly_event_uri")
  calendlyInviteeUri String?   @map("calendly_invitee_uri")
  eventType          String?   @map("event_type")
  scheduledAt        DateTime? @map("scheduled_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("advisor_bookings")
}
