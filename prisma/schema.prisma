// This is your Prisma schema file for PrimeCFO.ai
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
// ==========================================
// 1. CLIENT ENTITIES
// ==========================================
model Client {
  id              String   @id @default(uuid()) @map("client_id")
  clientName      String   @map("client_name")
  companyName     String?  @map("company_name")
  email           String   @unique
  phone           String?
  notes           String?
  tags            String[] @default([])
  clientType      String?  @map("client_type")
  isActive        Boolean  @default(true) @map("is_active")
  qboCustomerId   String?  @map("qbo_customer_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  qboConnections   ClientQboConnection[]
  qboTokens        QboToken[]
  assets           Asset[]
  financialMetrics FinancialMetric[]
  alerts           FinancialAlert[]
  advisoryNotes    AdvisoryNote[]
  actionItems      ActionItem[]
  documents        Document[]

  @@map("clients")
}

// ==========================================
// 2. QUICKBOOKS ONLINE OAUTH CONNECTIONS
// ==========================================
model ClientQboConnection {
  id           String    @id @default(uuid())
  clientId     String    @map("client_id")
  companyId    String    @map("company_id")
  customerId   String?   @map("customer_id")
  realmId      String?   @map("realm_id")
  syncEnabled  Boolean   @default(false) @map("sync_enabled")
  sandboxMode  Boolean   @default(false) @map("sandbox_mode")
  status       String    @default("pending")
  notes        String?
  connectedAt  DateTime? @map("connected_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_qbo_connections")
}

// ==========================================
// 3. QUICKBOOKS TOKEN VAULT
// ==========================================
model QboToken {
  id           String    @id @default(uuid())
  clientId     String    @unique @map("client_id")
  companyId    String?   @map("company_id")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("qbo_tokens")
}

// ==========================================
// 4. ASSET REGISTER & DEPRECIATION
// ==========================================
model Asset {
  id                 String   @id @default(uuid())
  clientId           String   @map("client_id")
  name               String
  category           String   @default("fixed") // fixed, intangible, investment, inventory, lease
  subcategory        String?
  purchaseDate       String?  @map("purchase_date")
  purchasePrice      Float    @default(0) @map("purchase_price")
  currentValue       Float    @default(0) @map("current_value")
  depreciationMethod String   @default("straight-line") @map("depreciation_method") // straight-line, declining, none
  usefulLife         Int      @default(5) @map("useful_life")
  salvageValue       Float    @default(0) @map("salvage_value")
  location           String?
  serialNumber       String?  @map("serial_number")
  vendor             String?
  warranty           String?
  status             String   @default("active") // active, disposed, impaired, in_transit
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("assets")
}

// ==========================================
// 5. FINANCIAL METRICS & STATEMENTS
// ==========================================
model FinancialMetric {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  period       String   @default("30d") // 30d, 90d, 12m, 4q
  cashPosition Float    @default(0) @map("cash_position")
  revenue      Float    @default(0)
  netProfit    Float    @default(0) @map("net_profit")
  profitMargin Float    @default(0) @map("profit_margin")
  arAging      Float    @default(0) @map("ar_aging")
  cashRunway   Float    @default(0) @map("cash_runway")
  basis        String   @default("cash") // cash, accrual
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("financial_metrics")
}

// ==========================================
// 6. SYSTEM & FINANCIAL ALERTS
// ==========================================
model FinancialAlert {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  severity       String   @default("warning") // critical, warning, info
  category       String   @default("Cash Horizon")
  title          String
  description    String
  actionRequired Boolean  @default(false) @map("action_required")
  isResolved     Boolean  @default(false) @map("is_resolved")
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("financial_alerts")
}

// ==========================================
// 7. CFO ADVISORY NOTES & WORKPAPERS
// ==========================================
model AdvisoryNote {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  content   String
  author    String   @default("CFO Lead")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("advisory_notes")
}

// ==========================================
// 8. CFO ACTION ITEMS / CHECKLIST
// ==========================================
model ActionItem {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  title       String
  description String?
  isCompleted Boolean   @default(false) @map("is_completed")
  priority    String    @default("normal") // high, normal, low
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("action_items")
}

// ==========================================
// 9. DOCUMENTS VAULT
// ==========================================
model Document {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  name      String
  code      String?
  type      String   @default("General") // Invoice, Tax Document, Statement, Report
  size      String?
  source    String   @default("Uploaded") // QuickBooks, Uploaded, Chase Feed
  fileUrl   String?  @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("documents")
}
